# Copy to `.env` to change the defaults. Environment variables override this file,
# the OTEL_* settings and VGRAPH_OTEL_LEVEL too.

# Database backend. Only `sqlite` is supported for now.
DB_DRIVER=sqlite

# SQLite database file. Leave unset, or set to `:memory:`, for a database that
# starts empty on every run.
DB_PATH=service.db

# Port the server listens on.
PORT=8080

# Load example data at startup when the database has no users: `true` (the
# default) or `false`.
SEED=true

# Where spans go: `otlp` (the collector of OTEL_EXPORTER_OTLP_ENDPOINT, in
# batches), `console` (stdout, each as it ends), both (`otlp,console`), or
# `none` (the default): no spans, and the GraphQL server says so at startup.
OTEL_TRACES_EXPORTER=otlp,console

# The service's name in the traces.
OTEL_SERVICE_NAME=service_otel

# The collector; this is the default, where `docker compose up` puts one.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# How much the models whose level is `default` (posts) record: `none`, `ops`
# (the default) or `full`.
VGRAPH_OTEL_LEVEL=ops
